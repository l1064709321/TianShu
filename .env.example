# 天枢配置模板
# 复制为 .env 后填写。providers 为 JSON 数组,可配置多家厂商。
# 除 Claude 外,市场主流厂商均兼容;协议均走 OpenAI 兼容接口。

# 默认使用哪家(pick 上面 providers 数组中的 name)
TIANSHU_DEFAULT_PROVIDER=deepseek

# ---- 单厂商写法 ----
# TIANSHU_PROVIDERS=[{"name":"deepseek","base_url":"https://api.deepseek.com/v1","api_key":"sk-xxx","model":"deepseek-chat","max_tokens":4096}]

# ---- 多厂商池写法(示例,填你的 key) ----
# 各家均为 OpenAI 兼容协议,base_url 即 /chat/completions 的上级:
#   OpenAI      https://api.openai.com/v1           模型 gpt-4o-mini
#   本地 Ollama http://localhost:11434/v1            模型 qwen2.5 (本地无需 key)
#   DeepSeek    https://api.deepseek.com/v1          模型 deepseek-chat
#   阿里通义    https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
#   月之暗面    https://api.moonshot.cn/v1           模型 moonshot-v1-8k
#   智谱 GLM    https://open.bigmodel.cn/api/paas/v4 模型 glm-4-flash
#   Kimi        https://api.moonshot.cn/v1           模型 kimi-latest
#   零一万物    https://api.lingyiwanwu.com/v1       模型 yi-lightning
#   阶跃星辰    https://api.stepfun.com/v1           模型 step-2-16k
#   百川智能    https://api.baichuan-ai.com/v1       模型 Baichuan4
#   火山引擎    https://ark.cn-beijing.volces.com/api/v3  模型 doubao-pro-32k
#   腾讯混元    https://api.hunyuan.cloud.tencent.com/v1   模型 hunyuan-turbos-latest
#   Groq        https://api.groq.com/openai/v1       模型 llama-3.3-70b-versatile
#   Mistral     https://api.mistral.ai/v1            模型 mistral-large-latest
#   NVIDIA      https://integrate.api.nvidia.com/v1  模型 meta/llama-3.3-70b-instruct
#   Cohere      https://api.cohere.com/v1            模型 command-r-plus

# ---- 模型聚合网关(一个 key 路由多家模型) ----
#   OpenRouter  https://openrouter.ai/api/v1         模型 任意(deepseek/openai/llama...)
#   硅基流动    https://api.siliconflow.cn/v1        模型 Qwen/Qwen2.5-72B-Instruct
#   Fireworks   https://api.fireworks.ai/inference/v1 模型 accounts/.../llama-3.3-70b
#   Together    https://api.together.xyz/v1          模型 meta-llama/...-instruct
#   Perplexity  https://api.perplexity.ai/chat/completions  模型 sonar-pro

# ---- 自建网关 / 本地推理框架(OpenAI 兼容) ----
#   OneAPI      https://你的域名/v1                  聚合你的各厂商 key
#   NewAPI      https://你的域名/v1                  同上
#   LiteLLM     http://localhost:4000/v1             自建代理网关
#   vLLM        http://localhost:8000/v1             本地 GPU 推理
#   SGLang      http://localhost:30000/v1            本地 GPU 推理
#   LM Studio   http://localhost:1234/v1             本地桌面推理
#   任意自建兼容服务: name 用 custom/local,填你自己的 base_url 即可

TIANSHU_PROVIDERS=[{"name":"deepseek","base_url":"https://api.deepseek.com/v1","api_key":"sk-在这里填key","model":"deepseek-chat","max_tokens":4096,"temperature":0.2,"timeout":120}]